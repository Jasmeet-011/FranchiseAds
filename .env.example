# Copy to .env and fill in real values. .env is git-ignored.
DB_URL=jdbc:postgresql://localhost:5432/franchiseads
DB_USERNAME=franchiseads
DB_PASSWORD=change-me
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional; defaults to claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-haiku-5-5
# Optional; defaults to low (low, medium, high, xhigh, max). none leaves output_config.effort out (ADR-026).
# ANTHROPIC_EFFORT=low
# Optional; defaults to true. false turns off /v3/api-docs and Swagger UI (ADR-036).
# API_DOCS_ENABLED=true
